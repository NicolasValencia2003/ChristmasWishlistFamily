# Supabase project URL (Project Settings → API → Project URL)
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase service_role key (Project Settings → API). SECRET: never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Allowed frontend origin(s) for CORS. Comma-separate several values.
FRONTEND_ORIGIN=http://localhost:5173
# Local dev port (optional)
PORT=3000
